[Unit]
Description=Barrio - backend (API de cuentas, economía y servidores)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=barrio
Group=barrio
WorkingDirectory=/opt/barrio/repo/backend
EnvironmentFile=/etc/barrio/backend.env
ExecStart=/opt/barrio/node/bin/node dist/server.js
Restart=always
RestartSec=5

# Endurecimiento: el backend no necesita escribir en disco ni ganar privilegios.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
