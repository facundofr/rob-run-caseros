# Copiar a .env y completar. Nunca subir .env al repositorio.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Sin DATABASE_URL se usa PGlite en ./data (solo desarrollo).
# DATABASE_URL=postgres://barrio:CAMBIAR@localhost:5432/barrio

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CAMBIAR_POR_UN_VALOR_ALEATORIO_DE_AL_MENOS_32_CARACTERES
SERVER_API_KEY=CAMBIAR_POR_OTRO_VALOR_ALEATORIO_LARGO

# Entrar con un nombre, sin Steam. Solo desarrollo.
AUTH_DEV_MODE=true

# Steam (cuando exista la app en Steamworks)
# STEAM_WEB_API_KEY=
# STEAM_APP_ID=
